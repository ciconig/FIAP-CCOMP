  "cues": [
    {
      "start": 0.0,
      "end": 4.22,
      "text": "A luz da garagem do bloco B apagou."
    },
    {
      "start": 4.84,
      "end": 7.5,
      "text": "No grupo do condomínio, surge a pergunta de sempre."
    },
    {
      "start": 7.8,
      "end": 9.28,
      "text": "Alguém já avisou?"
    },
    {
      "start": 9.58,
      "end": 13.22,
      "text": "Com o Nexcondo, esse aviso vira um chamado"
    },
    {
      "start": 13.22,
      "end": 15.92,
      "text": "que o morador pode acompanhar."
    },
    {
      "start": 16.24,
      "end": 19.96,
      "text": "O painel reúne os pedidos das áreas comuns"
    },
    {
      "start": 19.96,
      "end": 22.78,
      "text": "e mostra o que ainda precisa de atenção."
    },
    {
      "start": 22.78,
      "end": 27.08,
      "text": "Em Novo chamado, o morador escolhe iluminação,"
    },
    {
      "start": 27.08,
      "end": 31.72,
      "text": "marca a prioridade alta e indica onde está o problema."
    },
    {
      "start": 32.46,
      "end": 37.02,
      "text": "Basta descrever a falha na entrada da garagem e registrar."
    },
    {
      "start": 37.46,
      "end": 40.0,
      "text": "O chamado ganha um protocolo."
    },
    {
      "start": 40.22,
      "end": 44.6,
      "text": "Com esse código, a administração encontra a ocorrência"
    },
    {
      "start": 44.6,
      "end": 45.92,
      "text": "e inicia o atendimento."
    },
    {
      "start": 46.22,
      "end": 50.48,
      "text": "No dia seguinte, a equipe troca a luminária,"
    },
    {
      "start": 50.48,
      "end": 54.3,
      "text": "registra o teste e marca o chamado como resolvido."
    },
    {
      "start": 54.97,
      "end": 59.28,
      "text": "Quem consulta o histórico vê o que foi feito e quando."
    },
    {
      "start": 60.77,
      "end": 63.44,
      "text": "E onde concentrar o próximo reparo?"
    },
    {
      "start": 64.27,
      "end": 68.7,
      "text": "No mapa por bloco, a administração compara as pendências."
    },
    {
      "start": 68.86,
      "end": 72.86,
      "text": "Ao selecionar o bloco B, os gráficos e a lista"
    },
    {
      "start": 72.86,
      "end": 76.08,
      "text": "passam a mostrar os chamados daquele local."
    },
    {
      "start": 76.59,
      "end": 79.76,
      "text": "Da luz que apagou ao reparo confirmado,"
    },
    {
      "start": 79.76,
      "end": 82.52,
      "text": "cada etapa fica visível."
    },
    {
      "start": 83.6,
      "end": 88.5,
      "text": "Nexcondo. Chamados organizados. Comunidade conectada."
    }
  ]
}